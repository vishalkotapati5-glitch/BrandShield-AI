# Copy to .env (never commit .env)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://brandshield:brandshield@localhost:5432/brandshield
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# AI (used only if the organisation enables external AI and consents)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
